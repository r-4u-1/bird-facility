<?xml version="1.0" encoding="UTF-8"?>
<!--
  woods-system

  A stand-in for the lower-level business application. In real life this is
  another team's (often older) system that you only know by its XML contract.
  Here we build a small one so the whole chain can run end to end.

  It is a completely separate application (its own WAR), and on purpose it
  shares NO code with the bird facility modules. The only thing the two sides
  share is the XML format on the wire. That's realistic: you can't import
  classes from someone else's system, you can only agree on messages.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.birds</groupId>
        <artifactId>bird-facility</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>woods-system</artifactId>
    <packaging>war</packaging>

    <properties>
        <failOnMissingWebXml>false</failOnMissingWebXml>
    </properties>

    <dependencies>
        <!-- JAX-RS, CDI and JAXB from the server. Nothing from the bird facility modules. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>

        <!-- ===== Test-only: Mockito for BirdCatalog, Jersey to run the XML endpoint ===== -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.test-framework</groupId>
            <artifactId>jersey-test-framework-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.test-framework.providers</groupId>
            <artifactId>jersey-test-framework-provider-grizzly2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-jaxb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- woods-system.war -> URLs start with /woods-system -->
        <finalName>woods-system</finalName>
    </build>
</project>
